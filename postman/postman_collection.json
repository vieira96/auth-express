{
  "info": {
    "_postman_id": "df1a99d3-67ae-4c01-8ac8-3411c26023f1",
    "name": "Auth API",
    "description": "Rotas de autenticacao e usuarios da API Express. Execute Cadastro, Login e depois Listar usuarios. O JWT e retornado somente no login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "testEmail",
      "value": "ana.teste@exemplo.com"
    },
    {
      "key": "testPassword",
      "value": "Senha123!"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "usersPage",
      "value": "1"
    },
    {
      "key": "usersPerPage",
      "value": "10"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Cadastrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Cria um usuario e retorna somente os dados publicos dele."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Retorna 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Autentica o usuario de teste e atualiza a variavel accessToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Retorna 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "  pm.collectionVariables.set('accessToken', body.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/users?page={{usersPage}}&perPage={{usersPerPage}}",
            "description": "Lista usuarios autenticados com paginacao. Execute Login antes para preencher accessToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Retorna 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Nao retorna hash de senha', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.users).to.be.an('array');",
                  "  pm.expect(body.pagination).to.have.property('page');",
                  "  pm.expect(body.pagination).to.have.property('perPage');",
                  "  pm.expect(body.pagination).to.have.property('total');",
                  "  pm.expect(body.pagination).to.have.property('totalPages');",
                  "  body.users.forEach(function (user) {",
                  "    pm.expect(user).not.to.have.property('passwordHash');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
