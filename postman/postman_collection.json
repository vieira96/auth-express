{
  "info": {
    "_postman_id": "df1a99d3-67ae-4c01-8ac8-3411c26023f1",
    "name": "Auth API",
    "description": "Rotas de autenticacao da API Express. Altere testEmail se o cadastro retornar 409 por e-mail ja existente. O JWT e retornado somente no login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "testEmail",
      "value": "ana.teste@exemplo.com"
    },
    {
      "key": "testPassword",
      "value": "Senha123!"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Cadastrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Cria um usuario e retorna somente os dados publicos dele."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Retorna 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Autentica o usuario de teste e atualiza a variavel accessToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Retorna 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "  pm.collectionVariables.set('accessToken', body.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
